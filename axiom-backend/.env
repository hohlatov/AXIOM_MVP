# ========== БАЗА ДАННЫХ ==========
# Замените user, password, db_name на свои (из docker-compose)
database_url=postgresql://axiom_user:axiom_pass@db:5432/axiom_db

# ========== REDIS ==========
redis_url=redis://redis:6379/0

# ========== JWT ==========
# Сгенерируйте случайную строку: openssl rand -hex 32
jwt_secret=ваш_супер_секретный_ключ_тут_минимум_32_символа
jwt_algorithm=HS256
access_token_expire_minutes=60
refresh_token_expire_days=30

# ========== VK OAuth ==========
vk_client_id=ваш_vk_client_id
vk_client_secret=ваш_vk_client_secret
# Для продакшена домен вместо localhost:
vk_redirect_uri=https://relaxdev.ru/api/v1/auth/vk/callback

# ========== ФРОНТЕНД ==========
# ГЛАВНОЕ - поменять на продакшен URL!
frontend_url=https://relaxdev.ru

# ========== EMAIL (SMTP) ==========
# Если используете Yandex Cloud Postbox или любой SMTP
mail_from=no-reply@relaxdev.ru
smtp_host=smtp.yandex.ru  # или ваш SMTP-сервер
smtp_port=587
smtp_username=ваш_логин
smtp_password=ваш_пароль
smtp_use_tls=true

# ========== AI SERVICE ==========
ai_service_url=http://ai-service:8100  # если в отдельном контейнере
ai_service_timeout_seconds=20
ai_service_mock=false  # В продакшене false, если есть реальный AI-сервис