{
  "permissions": {
    "allow": [
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log:*)",
      "Bash(npm test:*)",
      "Bash(pnpm test:*)",
      "Bash(npm run lint:*)",
      "Bash(pnpm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(pnpm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(npx tsc:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}