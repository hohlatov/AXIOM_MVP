# --- Database ---
DATABASE_URL=postgresql+asyncpg://axiom:axiom@db:5432/axiom

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- VK ID OAuth (для входа через VK) ---
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:3000/auth/vk/callback

# --- Frontend (используется docker-compose при сборке фронтенда — см. Dockerfile) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Email (SMTP) ---
# Пусто = письма пишутся в лог вместо реальной отправки (для локальной разработки).
# На проде — заполнить данными Yandex Cloud Postbox (см. app/core/email.py).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@axiom.local

# --- AI-сервис Валентины (см. docs/ai-service-contract.md) ---
# ВАЖНО: на CPU-тесте (Qwen2.5-3B, 4-bit) среднее время ответа было 38.4 сек.
# На GPU должно быть значительно быстрее, но пока нет реальных цифр — таймаут
# ставим с запасом. Как только будут замеры на GPU, пересмотреть и это значение,
# и решение "синхронный HTTP-запрос vs асинхронная задача с поллингом" в контракте.
AI_SERVICE_URL=http://localhost:8100
AI_SERVICE_TIMEOUT_SECONDS=20
# true = диагностика работает на встроенных тестовых данных, без реального
# сервиса Валентины (для разработки/тестов). Переключить на false, когда её
# сервис задеплоен и указан правильный AI_SERVICE_URL.
AI_SERVICE_MOCK=true
